                                "userAnswer": "",
                                "isSelected": "0",
                                "id": "3c2d1f7158ee458eb874a459d752c580",
                                "content": "Pruritus"
                            },
                            {
                                "isRight": "1",
                                "userAnswer": "",
                                "isSelected": "0",
                                "id": "f211860ffc7a4762b5f277b1428c6d41",
                                "content": "Tinnitus"
                            },
                            {
                                "isRight": "0",
                                "userAnswer": "",
                                "isSelected": "0",
                                "id": "f614319125b84251bb705aa0ede6bd0f",
                                "content": "Hearing loss"
                            },
                            {
                                "isRight": "0",
                                "userAnswer": "",
                                "isSelected": "0",
                                "id": "92249cc893fb49fbbffece322ebcdf49",
                                "content": "Burning in the ear"
                            }
                        ],
