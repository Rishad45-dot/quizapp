                            {
                                "isRight": "0",
                                "userAnswer": "",
                                "isSelected": "0",
                                "id": "04ef0888d0e74c7693237db0c430bdd7",
                                "content": "50% human insulin isophane/50% human insulin"
                            }
                        ],
                        "extJson": {
