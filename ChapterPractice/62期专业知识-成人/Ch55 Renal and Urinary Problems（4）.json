                                "id": "f83d8574882e49548761d769e0f2c743",
                                "content": "Urge incontinence"
                            },
                            {
                                "isRight": "0",
                                "userAnswer": "",
                                "isSelected": "0",
                                "id": "d2a61e04a3594621b90844ed5427726a",
                                "content": "Stress incontinence"
                            },
                            {
                                "isRight": "1",
                                "userAnswer": "",
                                "isSelected": "0",
                                "id": "47ee0288acff4c7f9674911fa70b85dc",
