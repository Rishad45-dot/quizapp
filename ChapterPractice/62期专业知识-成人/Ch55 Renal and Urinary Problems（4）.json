                            {
                                "isRight": "0",
                                "userAnswer": "",
                                "isSelected": "0",
                                "id": "8cdcb5b0aa454adea4064868741f4575",
                                "content": "Night-light present in the hall between the bedroom and bathroom"
                            }
                        ],
