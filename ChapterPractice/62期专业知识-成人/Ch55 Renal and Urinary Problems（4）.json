                                "content": "BUN 23 mg/dL (8.3 mmol/L)"
                            },
                            {
                                "isRight": "0",
                                "userAnswer": "",
                                "isSelected": "0",
                                "id": "235f809d71a34a19af7d380d4b7bf63d",
                                "content": "BUN 29 mg/dL (10.4 mmol/L)"
                            },
