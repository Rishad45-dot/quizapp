                                "isRight": "0",
                                "userAnswer": "",
                                "isSelected": "0",
                                "id": "2c8b1fde458e4c45aed78dbc73eacbb1",
                                "content": "Increase the flow rate of the intravenous infusion."
                            }
                        ],
