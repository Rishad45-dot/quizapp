                            {
                                "isRight": "0",
                                "userAnswer": "",
                                "isSelected": "0",
                                "id": "afa369e1e39140cd935834ef6c651645",
                                "content": "It is when a protein is produced in response to a viral infection."
                            },
                            {
                                "isRight": "1",
                                "userAnswer": "",
                                "isSelected": "0",
                                "id": "611a4eda108e49819f9a27ed51c45aad",
                                "content": "It is a process by which a particle is ingested and digested by a cell."
                            }
                        ],
                        "extJson": {
                            "optionList": [
                                {
                                    "isRight": "0",
                                    "userAnswer": "",
                                    "isSelected": "0",
                                    "id": "2cd37508fe8e4bed8baa7abd55273973",
                                    "content": "It is the initial reaction in the inflammatory response."
