                                "isRight": "1",
                                "userAnswer": "",
                                "isSelected": "0",
                                "id": "21ad05965d334eb191adc7551efa61a3",
                                "content": "Place the client in a sitting position."
                            },
                            {
                                "isRight": "0",
                                "userAnswer": "",
                                "isSelected": "0",
                                "id": "5218f73b689e41458ee167e20131d967",
                                "content": "Check the urinary catheter tubing for kinks or obstruction."
                            }
