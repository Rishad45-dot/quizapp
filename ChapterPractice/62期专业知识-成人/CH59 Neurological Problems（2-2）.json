                                "isRight": "0",
                                "userAnswer": "",
                                "isSelected": "0",
                                "id": "0a24a5f2edf541dfa86c647f20198bb2",
                                "content": "Encouraging hourly deep breathing"
                            },
                            {
                                "isRight": "0",
                                "userAnswer": "",
                                "isSelected": "0",
                                "id": "9bd6c369fba54a8cb2ad6abb1cf81263",
                                "content": "Repositioning gently side to side every 2 hours"
                            }
                        ],
                        "extJson": {
