                                "userAnswer": "",
                                "isSelected": "0",
                                "id": "c10f296a60a544a1a75b8571c5408882",
                                "content": "Notify the neurologist."
                            },
                            {
                                "isRight": "0",
                                "userAnswer": "",
                                "isSelected": "0",
                                "id": "2cdfb176f7b54b67a0c419627c42cc0b",
                                "content": "Loosen tight clothing on the client."
                            },
