                                "content": "Paradoxical respirations"
                            },
                            {
                                "isRight": "1",
                                "userAnswer": "",
                                "isSelected": "0",
                                "id": "f1c82588d593484a8d19d43dfbea4f35",
                                "content": "Pain, especially with inspiration"
                            }
                        ],
