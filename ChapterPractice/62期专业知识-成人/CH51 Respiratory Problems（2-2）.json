                                "userAnswer": "",
                                "isSelected": "0",
                                "id": "0b8dd8df02b046148e9517a204c6100f",
                                "content": "Osmosis"
                            },
                            {
                                "isRight": "1",
                                "userAnswer": "",
                                "isSelected": "0",
                                "id": "31d435309a424f79939b9c77fa6386c7",
                                "content": "Diffusion"
