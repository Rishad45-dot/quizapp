                                "content": "Resuscitation equipment"
                            },
                            {
                                "isRight": "0",
                                "userAnswer": "",
                                "isSelected": "0",
                                "id": "1bde3a07650c466499da6029e99e0210",
                                "content": "Central line insertion tray"
                            }
                        ],
