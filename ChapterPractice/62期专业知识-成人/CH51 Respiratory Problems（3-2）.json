                                "id": "c71cf47c60fc4040922a148cc3292531",
                                "content": "A 73-year-old client who has just had pinning of a hip fracture"
                            },
                            {
                                "isRight": "0",
                                "userAnswer": "",
                                "isSelected": "0",
                                "id": "8c513c191ad24dee900285f638329321",
                                "content": "A 38-year-old client with pulmonary contusion sustained in an automobile crash"
                            }
                        ],
                        "extJson": {
                            "optionList": [
                                {
                                    "isRight": "0",
