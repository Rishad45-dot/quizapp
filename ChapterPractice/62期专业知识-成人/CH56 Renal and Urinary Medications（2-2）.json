                                "userAnswer": "",
                                "isSelected": "0",
                                "id": "ed16558f15914023b49a3f49882df8d7",
                                "content": "Intramuscularly"
                            },
                            {
                                "isRight": "1",
                                "userAnswer": "",
                                "isSelected": "0",
                                "id": "f642e28d9b43440c909c30830e88be8c",
                                "content": "Subcutaneously"
