                                "id": "313f080e7ac14033bf2c5efa6a63fdfe",
                                "content": "Ulcerative colitis"
                            },
                            {
                                "isRight": "1",
                                "userAnswer": "",
                                "isSelected": "0",
                                "id": "cf2f6988a15642e4838ce0470b857709",
                                "content": "Overactive bladder"
