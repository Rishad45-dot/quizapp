                                "isRight": "0",
                                "userAnswer": "",
                                "isSelected": "0",
                                "id": "5adbdf90f4954a95bba9e48c431234c8",
                                "content": "Pallor"
                            },
                            {
                                "isRight": "0",
                                "userAnswer": "",
                                "isSelected": "0",
                                "id": "02738033f90b46549c580b6c28b6501b",
                                "content": "Drowsiness"
                            },
                            {
                                "isRight": "0",
                                "userAnswer": "",
                                "isSelected": "0",
                                "id": "0d84e17343324980a727ca157ea69423",
                                "content": "Bradycardia"
                            },
                            {
                                "isRight": "1",
                                "userAnswer": "",
                                "isSelected": "0",
                                "id": "56691b2412264f8f8fa3f189d367673b",
                                "content": "Restlessness"
                            }
                        ],
                        "extJson": {
