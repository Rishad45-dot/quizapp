                                "userAnswer": "",
                                "isSelected": "0",
                                "id": "7be618dd8e764e45a323fbd016a467c9",
                                "content": "Infusing only through a central line"
                            },
                            {
                                "isRight": "0",
                                "userAnswer": "",
                                "isSelected": "0",
                                "id": "60feb14db388476ead7c75637673ae3a",
                                "content": "Infusing rapidly as a direct IV push medication"
