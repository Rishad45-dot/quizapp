                                "userAnswer": "",
                                "isSelected": "0",
                                "id": "820be1b2b4c0400587835ede4c1a9a8a",
                                "content": "Floating spots"
                            },
                            {
                                "isRight": "1",
                                "userAnswer": "",
                                "isSelected": "0",
                                "id": "60a0b638e85e4c68ac71040bee9a27c2",
