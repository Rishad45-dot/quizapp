                                "isSelected": "0",
                                "id": "98829a85e04e4b99b913e022824c2d0e",
                                "content": "Document the finding."
                            },
                            {
                                "isRight": "0",
                                "userAnswer": "",
                                "isSelected": "0",
                                "id": "fd07c2ee82f94db096f4573e100a1dbd",
                                "content": "Reinforce the dressing."
                            },
                            {
                                "isRight": "1",
