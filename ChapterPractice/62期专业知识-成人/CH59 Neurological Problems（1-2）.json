                        "type": "0",
                        "version": 0,
                        "content": "The nurse is assessing the motor and sensory function of an unconscious client who sustained a head injury. The nurse would use which technique to test the client's peripheral response to pain?",
                        "subjectId": "ad5ab04c79144c0ea9b83385308c3b1d",
                        "difficultyIds": "11797937e327eb6d913faa80427c566b",
                        "difficulty": "考试范围-Analyzing 分析",
                        "textAnalysis": "Rationale:\nPressure on nail beds tests a basic motor and sensory peripheral response. Cerebral responses to pain are tested using a sternal rub, placing upward pressure on the orbital rim, or squeezing the clavicle or sternocleidomastoid muscle.\n",
                        "id": "249e6f89d7cf425ab7d0cca4df22b4e2",
                        "mark": "0",
                        "collectionState": "0"
                    },
                    {
                        "optionList": [
                            {
                                "isRight": "0",
                                "userAnswer": "",
                                "isSelected": "0",
                                "id": "cf49141c7b7a4eb795073aac526282fb",
                                "content": "It will cause arteriovenous shunting."
                            },
                            {
                                "isRight": "1",
                                "userAnswer": "",
                                "isSelected": "0",
                                "id": "22e9ff8fae064c59947f42fb9b220de3",
                                "content": "It will cause vasodilation of blood vessels in the brain."
                            },
                            {
                                "isRight": "0",
                                "userAnswer": "",
                                "isSelected": "0",
                                "id": "85daeae9db224d7ba339a6c2a8ce0a0c",
                                "content": "It will cause blood vessels in the circle of Willis to collapse."
                            },
                            {
                                "isRight": "0",
                                "userAnswer": "",
                                "isSelected": "0",
                                "id": "465e57a9853c4b408ce8e6d665b790da",
                                "content": "It will cause hyperresponsiveness of blood vessels in the brain."
                            }
                        ],
                        "extJson": {
                            "optionList": [
                                {
                                    "isRight": "0",
                                    "userAnswer": "",
                                    "isSelected": "0",
                                    "id": "cf49141c7b7a4eb795073aac526282fb",
                                    "content": "It will cause arteriovenous shunting."
                                },
                                {
                                    "isRight": "1",
                                    "userAnswer": "",
                                    "isSelected": "0",
                                    "id": "22e9ff8fae064c59947f42fb9b220de3",
                                    "content": "It will cause vasodilation of blood vessels in the brain."
                                },
                                {
                                    "isRight": "0",
                                    "userAnswer": "",
                                    "isSelected": "0",
                                    "id": "85daeae9db224d7ba339a6c2a8ce0a0c",
                                    "content": "It will cause blood vessels in the circle of Willis to collapse."
                                },
                                {
                                    "isRight": "0",
                                    "userAnswer": "",
                                    "isSelected": "0",
                                    "id": "465e57a9853c4b408ce8e6d665b790da",
                                    "content": "It will cause hyperresponsiveness of blood vessels in the brain."
                                }
                            ]
