                                },
                                {
                                    "isRight": "0",
                                    "userAnswer": "",
                                    "isSelected": "0",
                                    "id": "6710810ccef2478f8e0bd29e3b84608f",
                                    "content": "Tub bath or shower is permitted, but the scalp is kept dry until the sutures are removed."
                                },
