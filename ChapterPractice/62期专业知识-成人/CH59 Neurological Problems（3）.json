                                "id": "1a4917ad4d4c4e5aa05ad20d6cf78f2b",
                                "content": "Omitting doses of medication"
                            },
                            {
                                "isRight": "0",
                                "userAnswer": "",
                                "isSelected": "0",
                                "id": "e2178c638b774793ae7962bf70b5b9b3",
                                "content": "Increasing intake of fatty foods"
