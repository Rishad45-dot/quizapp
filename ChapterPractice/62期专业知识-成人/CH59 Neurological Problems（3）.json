                                "isRight": "0",
                                "userAnswer": "",
                                "isSelected": "0",
                                "id": "e4dbab57e7ff4c1f8d9e7d03a6343c79",
                                "content": "Are you consistently fatigued?"
                            },
                            {
                                "isRight": "0",
