                                    "isSelected": "0",
                                    "id": "8908b98c006d48e5b14ef647b58877d7",
                                    "content": "Checking the frequency and consistency of bowel movements"
                                },
                                {
                                    "isRight": "0",
                                    "userAnswer": "",
                                    "isSelected": "0",
                                    "id": "636c9167b86f4b198b93cb74de0d3a97",
                                    "content": "Checking serum liver enzyme levels before and after the infusion"
                                },
                                {
                                    "isRight": "0",
