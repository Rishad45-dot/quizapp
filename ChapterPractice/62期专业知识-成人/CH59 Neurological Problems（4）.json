                                "userAnswer": "",
                                "isSelected": "0",
                                "id": "20b0d80aa6e24119b1ba9895e4c25aec",
                                "content": "Nebulizer and pulse oximeter"
                            },
                            {
                                "isRight": "0",
                                "userAnswer": "",
                                "isSelected": "0",
                                "id": "9aede53a50d344f5be54436627763dbd",
                                "content": "Blood pressure cuff and flashlight"
                            },
