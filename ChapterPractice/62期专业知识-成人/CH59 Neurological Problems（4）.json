                                "isSelected": "0",
                                "id": "3134b4ef207045a780bada63d2c84a33",
                                "content": "Client is demonstrating ataxia."
                            },
                            {
                                "isRight": "1",
                                "userAnswer": "",
                                "isSelected": "0",
                                "id": "447e9f35ac6b48158f4dd12a247b2083",
                                "content": "Client is exhibiting pronator drift."
                            },
