                                "id": "90326a51550245868de831db21effa42",
                                "content": "Flashlight and incentive spirometer"
                            },
                            {
                                "isRight": "1",
                                "userAnswer": "",
                                "isSelected": "0",
                                "id": "535b16f9993b4b3e91d818f5a52f085d",
                                "content": "Electrocardiographic monitoring electrodes and intubation tray"
                            }
                        ],
                        "extJson": {
                            "optionList": [
                                {
                                    "isRight": "0",
                                    "userAnswer": "",
                                    "isSelected": "0",
                                    "id": "20b0d80aa6e24119b1ba9895e4c25aec",
