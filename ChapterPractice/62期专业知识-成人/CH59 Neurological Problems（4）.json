                                    "content": "Bilateral calf measure"
                                },
                                {
                                    "isRight": "0",
                                    "userAnswer": "",
                                    "isSelected": "0",
                                    "id": "ac9d2ef1136a444fa5a209d39fcc168b",
                                    "content": "Monitor vital signs frequently"
                                },
