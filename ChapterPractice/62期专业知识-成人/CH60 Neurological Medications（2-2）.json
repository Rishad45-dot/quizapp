                                "userAnswer": "",
                                "isSelected": "0",
                                "id": "882c158be8994ab5b1510d7181a03b51",
                                "content": "Discard the vial."
                            },
                            {
                                "isRight": "1",
                                "userAnswer": "",
                                "isSelected": "0",
                                "id": "011b4eaebdb34355bcca26d99293f4cc",
                                "content": "Place the vial in warm water."
                            },
                            {
                                "isRight": "0",
