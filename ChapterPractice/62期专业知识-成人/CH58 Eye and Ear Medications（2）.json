                                "userAnswer": "",
                                "isSelected": "0",
                                "id": "4cd50232f0f04a718b6396aac8613d77",
                                "content": "An osmotic diuretic"
                            },
                            {
                                "isRight": "1",
                                "userAnswer": "",
                                "isSelected": "0",
                                "id": "c90b2c6dff944a51ac489056b364a0d9",
                                "content": "A mydriatic medication"
                            }
                        ],
