                                "isRight": "0",
                                "userAnswer": "",
                                "isSelected": "0",
                                "id": "658755045f894731ad02a425bfe7d793",
                                "content": "Assessing for edema"
                            },
                            {
                                "isRight": "0",
                                "userAnswer": "",
                                "isSelected": "0",
                                "id": "954a5e2d25194a5488535c382f0fab9e",
