                                "id": "d596204a3ba7424fb509174003f2f7f0",
                                "content": "Blood urea nitrogen results"
                            },
                            {
                                "isRight": "0",
                                "userAnswer": "",
                                "isSelected": "0",
                                "id": "7ed079571b5f4285a8ef391b3fc7e544",
                                "content": "Urine for glucose and ketones"
                            }
                        ],
