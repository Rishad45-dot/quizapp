                                "isSelected": "0",
                                "id": "a38a7d14840948b7bbf4b4fc87989a5e",
                                "content": "Increase the destruction of tumor cells."
                            },
                            {
                                "isRight": "0",
                                "userAnswer": "",
                                "isSelected": "0",
                                "id": "d9adc82b6803476d916d822ee18551f8",
                                "content": "Prevent the destruction of normal cells."
                            },
