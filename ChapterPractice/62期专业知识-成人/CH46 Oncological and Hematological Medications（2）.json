                                "isSelected": "0",
                                "id": "47d9859c2338419ca050a2fc3200a04e",
                                "content": "Decrease the risk of the alopecia and stomatitis."
                            },
                            {
                                "isRight": "0",
                                "userAnswer": "",
                                "isSelected": "0",
                                "id": "b4b189299d4e46d0b1af9a4cef3dbca9",
                                "content": "Increase the likelihood of erythrocyte and leukocyte recovery."
